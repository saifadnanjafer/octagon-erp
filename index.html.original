    <div class="glass-card" style="width:400px; padding:40px; text-align:center; box-shadow:0 25px 50px rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.1);">
      <div style="background:var(--primary); width:80px; height:80px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; box-shadow:0 0 20px rgba(59, 130, 246, 0.4);">
