<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <!-- IMPORTANT: Save this file as UTF-8. Arabic UI depends on UTF-8 encoding. -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Octagon ERP | نظام إدارة الورشة والمخزون والرواتب</title>
