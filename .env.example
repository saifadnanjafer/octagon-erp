# Octagon ERP environment template
# Copy this file to .env for local development. Never commit .env.

# Server mode and ports
NODE_ENV=development
PORT=8080
OCTAGON_DEFAULT_PORT=8080
OCTAGON_FALLBACK_PORTS=8091,8092,8093,8094,8095

# Local operational data paths. These files are intentionally excluded from Git.
OCTAGON_DB_FILE=./database.json
OCTAGON_SQLITE_DB_FILE=./database.db
USE_SQLITE=true
OCTAGON_BACKUP_DIR=./backups
OCTAGON_BACKUP_LOG=./server-backup.log
OCTAGON_REVIEW_REPORT_DIR=./review-reports

# Local security behavior
OCTAGON_PRODUCTION=false
OCTAGON_TRUST_LOCALHOST=true
OCTAGON_ALLOW_CRITICAL_TOOLS=false
OCTAGON_JARVIS_APPROVALS_FILE=./server-ai-approvals.json
OCTAGON_JARVIS_AUDIT_LOG_FILE=./server-ai-audit.log

# Scheduler controls
OCTAGON_SCHEDULER_DISABLED=false
OCTAGON_SCHEDULER_POLL_MS=60000

# Custom OpenAI-compatible provider
CUSTOM_API_KEY=change-me
CUSTOM_API_ENDPOINT=https://api.example.com/v1
CUSTOM_API_PROVIDER=example-provider
CUSTOM_API_MODEL=example-model

# AI provider keys
OPENROUTER_API_KEY=change-me
CONTACTBOX_API_KEY=change-me
CONTACTBOX_ENDPOINT=https://api.example.com/v1/chat/completions
GEMINI_API_KEY=change-me
GOOGLE_API_KEY=change-me
GOOGLE_TTS_API_KEY=change-me

# WhatsApp webhook integration
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_VERIFY_TOKEN=change-me
