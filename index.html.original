              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="assets" id="navAssets" onclick="switchPage('assets')">
              <span class="nav-icon">🏷️</span>
              <span class="nav-label">الأصول والصيانة</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="subscriptions" id="navSubscriptions" onclick="switchPage('subscriptions')">
              <span class="nav-icon">🔁</span>
              <span class="nav-label">الاشتراكات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="people_ops" id="navPeopleOps" onclick="switchPage('people_ops')">
              <span class="nav-icon">🧑‍💼</span>
              <span class="nav-label">التوظيف والإجازات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="helpdesk" id="navHelpdesk" onclick="switchPage('helpdesk')">
              <span class="nav-icon">🎫</span>
              <span class="nav-label">خدمة العملاء</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="fleet" id="navFleet" onclick="switchPage('fleet')">
              <span class="nav-icon">🚚</span>
              <span class="nav-label">المركبات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="documents" id="navDocuments" onclick="switchPage('documents')">
              <span class="nav-icon">🗂️</span>
              <span class="nav-label">الوثائق</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="marketing" id="navMarketing" onclick="switchPage('marketing')">
              <span class="nav-icon">📣</span>
              <span class="nav-label">التسويق والحملات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="budgeting" id="navBudgeting" onclick="switchPage('budgeting')">
              <span class="nav-icon">🧮</span>
              <span class="nav-label">الموازنات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="procurement" id="navProcurement" onclick="switchPage('procurement')">
              <span class="nav-icon">📦</span>
              <span class="nav-label">المشتريات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="projects" id="navProjects" onclick="switchPage('projects')">
              <span class="nav-icon">📁</span>
              <span class="nav-label">المشاريع</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="approvals" id="navApprovals" onclick="switchPage('approvals')">
              <span class="nav-icon">✅</span>
              <span class="nav-label">الموافقات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="field_service" id="navFieldService" onclick="switchPage('field_service')">
              <span class="nav-icon">🧰</span>
              <span class="nav-label">الخدمة الميدانية</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="rental" id="navRental" onclick="switchPage('rental')">
              <span class="nav-icon">📤</span>
              <span class="nav-label">تأجير المعدات</span>
              <span class="nav-indicator"></span>
            </button>
          </div>
        </div>

        <div class="nav-group" data-nav-group="omni_dev">
          <button class="nav-group-toggle" type="button" onclick="toggleNavGroup('omni_dev')">
            <span>OMNI التطوير وبوابات النظام</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="nav-group-body" id="navGroupOmniDev">
            <button class="nav-btn" data-page="multi_entity" id="navMultiEntity" onclick="switchPage('multi_entity')">
              <span class="nav-icon">🌐</span>
              <span class="nav-label">الفروع والعملات</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="tax_compliance" id="navTaxCompliance" onclick="switchPage('tax_compliance')">
              <span class="nav-icon">🧾</span>
              <span class="nav-label">الضرائب والفوترة</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="employee_ui" id="navEmployeeUI" onclick="switchPage('employee_ui')">
              <span class="nav-icon">🧑‍🔧</span>
              <span class="nav-label">لوحة الموظف</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="customer_portal" id="navCustomerPortal" onclick="switchPage('customer_portal')">
              <span class="nav-icon">👥</span>
              <span class="nav-label">بوابة العميل</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="admin_panel" id="navAdminPanel" onclick="switchPage('admin_panel')">
              <span class="nav-icon"><i class="fa-solid fa-screwdriver-wrench"></i></span>
              <span class="nav-label">لوحة تحكم الأدمن</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="help_manual" id="navHelpManual" onclick="switchPage('help_manual')">
              <span class="nav-icon"><i class="fa-solid fa-circle-question"></i></span>
              <span class="nav-label">دليل الاستخدام</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="ai_queue" id="navAiQueue" onclick="switchPage('ai_queue')">
              <span class="nav-icon">⚙️</span>
              <span class="nav-label">طابور الذكاء</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="ai_factory" id="navAiFactory" onclick="switchPage('ai_factory')">
              <span class="nav-icon">🏗️</span>
              <span class="nav-label">مصنع التطوير</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="ai_tools" id="navAiTools" onclick="switchPage('ai_tools')">
              <span class="nav-icon">🧰</span>
              <span class="nav-label">سجل أدوات الذكاء</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="ai_status" id="navAiStatus" onclick="switchPage('ai_status')">
              <span class="nav-icon">🛡️</span>
              <span class="nav-label">حالة الذكاء الصناعي</span>
              <span class="nav-indicator"></span>
            </button>
            <button class="nav-btn" data-page="deploy_ready" id="navDeployReady" onclick="switchPage('deploy_ready')">
              <span class="nav-icon">🚀</span>
              <span class="nav-label">جاهزية التشغيل</span>
              <span class="nav-indicator"></span>
            </button>
          </div>
        </div>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-actions" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
          <button class="btn-theme-switcher" id="btnThemeSwitcher" onclick="cycleTheme()" title="تبديل المظهر"
            style="width: 100%;">
            <span class="theme-icon">🎨</span>
            <span class="theme-label">المظهر</span>
          </button>
          <div class="sidebar-row" style="display: flex; gap: 8px;">
            <button class="btn-small-action" onclick="exportData()" title="تصدير نسخة احتياطية"
              style="flex: 1; padding: 8px; font-size: 11px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); color: var(--accent-blue); border-radius: 6px; cursor: pointer;">
              📥 نبذة احتياطية
            </button>
            <button class="btn-small-action" onclick="importDataClick()" title="استعادة نسخة احتياطية"
              style="flex: 1; padding: 8px; font-size: 11px; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.2); color: var(--accent-green); border-radius: 6px; cursor: pointer;">
              📤 استعادة
            </button>
            <input type="file" id="importFile" accept=".json" style="display: none;" onchange="importData(event)">
          </div>
        </div>
        <button class="btn-reset" id="btnResetData" onclick="resetAllData()">
          <span>🗑️</span> مسح البيانات
        </button>
        <button class="btn-clear-cache" onclick="clearCache()" title="تنظيف الذاكرة المؤقتة (للمبرمجين فقط)"
          style="width: 100%; margin-top: 4px; padding: 6px; font-size: 10px; background: transparent; border: 1px dashed rgba(255,255,255,0.1); color: rgba(255,255,255,0.3); border-radius: 4px; cursor: pointer; transition: all 0.3s; height: auto;">
          ⚡ Clear Cache
        </button>
        <div class="sidebar-version">OCTAGON ERP v5.0</div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content" id="mainContent">
      
      <!-- Unified Top Bar Meta -->
      <div class="header-meta-bar">
        <div class="meta-time-group">
          <i class="fa-solid fa-clock"></i>
          <span id="globalClock">00:00:00</span>
        </div>
        <div class="meta-date-group">
          <span id="globalDate">Thursday, 16 April 2026</span>
          <i class="fa-solid fa-calendar-day"></i>
        </div>
        <div class="meta-auth-group" style="display:flex;align-items:center;gap:10px;margin-right:20px;padding:5px 15px;background:rgba(255,255,255,0.05);border-radius:10px;">
          <i class="fa-solid fa-user-shield" style="color:var(--primary)"></i>
          <select id="authUserSwitcher" onchange="switchAuthUser(this.value)" style="background:none;border:none;color:var(--text);font-family:inherit;font-size:13px;outline:none;cursor:pointer;">
            <option value="system">مدير النظام (Admin)</option>
            <option value="mgr_finance">حسابات - مدير (Manager)</option>
            <option value="user_finance">محاسب متدرب (User)</option>
            <option value="mgr_workshop">مدير الورشة (Workshop)</option>
          </select>
          <button onclick="performLogout()" style="background:none; border:none; color:var(--accent-red); cursor:pointer; font-size:14px; margin-right:5px; padding:0;" title="تسجيل الخروج">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>
        <div id="omniNotificationHost" class="omni-notification-host"></div>
      </div>

      <!-- ═══════════ CALCULATOR PAGE ═══════════ -->
      <section class="page page-active" id="pageCalculator">
        <div class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">
              <span class="title-icon">🧮</span>
              حاسبة الراتب
            </h1>
            <p class="page-subtitle">أدخل بيانات الموظف لحساب الراتب الشهري بشكل فوري</p>
          </div>
          <div class="page-header-actions" style="display: flex; gap: 10px;">
            <button class="btn-primary" onclick="verifyCalculatorWithAI()" id="btnVerifyCalcAI" style="background: linear-gradient(135deg, #a855f7, #ec4899); border: none; font-weight: bold;">
              <i class="fa-solid fa-wand-magic-sparkles"></i> مراجعة الراتب بالذكاء الاصطناعي
            </button>
            <button class="btn-primary" onclick="printReceipt()">
              <span>🖨️</span> طباعة الوصل
            </button>
          </div>
        </div>

        <!-- Employee Selector -->
        <div class="emp-selector-bar glass-card" id="calcEmpSelector">
          <div class="emp-selector-content">
            <span class="emp-selector-icon">👤</span>
            <div class="emp-selector-group">
              <label class="config-label">اختيار الموظف</label>
              <select id="calcEmpSelect" class="config-input config-select emp-dropdown" onchange="onCalcEmpChange()">
                <option value="-1">— حساب مباشر (بدون موظف) —</option>
              </select>
            </div>
            <div class="emp-selector-badge" id="calcEmpBadge" style="display:none;">
              <span class="badge-icon">📋</span>
              <span class="badge-text" id="calcEmpBadgeText">بيانات مسحوبة من التايم شيت</span>
            </div>
          </div>
        </div>

        <!-- Quick Config -->
        <div class="config-bar glass-card">
          <div class="config-group">
            <label class="config-label">الشهر</label>
            <select id="cfgMonth" class="config-input config-select" onchange="onMonthYearChange()">
              <option value="1">يناير</option>
              <option value="2">فبراير</option>
              <option value="3" selected>مارس</option>
              <option value="4">أبريل</option>
              <option value="5">مايو</option>
              <option value="6">يونيو</option>
              <option value="7">يوليو</option>
              <option value="8">أغسطس</option>
              <option value="9">سبتمبر</option>
              <option value="10">أكتوبر</option>
              <option value="11">نوفمبر</option>
              <option value="12">ديسمبر</option>
            </select>
          </div>
          <div class="config-group">
            <label class="config-label">السنة</label>
            <input type="number" id="cfgYear" class="config-input" value="2026" min="2020" max="2040"
              onchange="onMonthYearChange()">
          </div>
          <div class="config-group">
            <label class="config-label">الراتب الاسمي</label>
            <div class="input-with-unit">
              <input type="number" id="cfgSalary" class="config-input" value="500000" onchange="recalculate()">
              <span class="input-unit">د.ع</span>
            </div>
          </div>
          <div class="config-group">
            <label class="config-label">مخصصات النقل</label>
            <div class="input-with-unit">
              <input type="number" id="cfgTransport" class="config-input" value="50000" onchange="recalculate()">
              <span class="input-unit">د.ع</span>
            </div>
          </div>
          <div class="config-group">
            <label class="config-label">مخصصات الطعام</label>
            <div class="input-with-unit">
              <input type="number" id="cfgFood" class="config-input" value="50000" onchange="recalculate()">
              <span class="input-unit">د.ع</span>
            </div>
          </div>
        </div>

        <!-- Calculator AI Response Box -->
        <div id="calcAIResponseContainer" class="glass-card" style="display: none; margin-bottom: 20px; padding: 20px 25px; border-right: 4px solid #a855f7;">
          <div style="display: flex; gap: 15px; align-items: flex-start;">
            <div style="background: rgba(168, 85, 247, 0.1); padding: 15px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 5px;">
              <i class="fa-solid fa-robot fa-2x" style="color: #a855f7;"></i>
            </div>
            <div style="flex: 1;">
              <strong style="color: #a855f7; font-size: 15px; display: block; margin-bottom: 10px;">تقرير مراجعة الذكاء الاصطناعي للحاسبة:</strong>
              <div id="calcAIResponseText" style="color: #e2e8f0; font-size: 14px; line-height: 1.8; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border: 1px solid rgba(168, 85, 247, 0.3);"></div>
            </div>
          </div>
        </div>

        <!-- Calculator Form -->
        <div class="calc-grid">
          <!-- LEFT: Input Form -->
          <div class="calc-form glass-card">
            <h2 class="section-title">
              <span class="section-icon">📅</span>
              توزيع أيام الشهر
            </h2>

            <!-- Days Warning -->
            <div class="days-warning" id="daysWarning" style="display:none;">
              <span class="warning-icon">⚠️</span>
              <span class="warning-text" id="daysWarningText">مجموع الأيام يتجاوز أيام الشهر!</span>
            </div>

            <!-- Days Summary Bar -->
            <div class="days-summary-bar" id="daysSummaryBar">
              <div class="days-summary-info">
                <span>المجموع: <b id="daysSumDisplay">0</b> / <b id="daysMonthDisplay">31</b> يوم</span>
                <span class="days-remaining" id="daysRemaining"></span>
              </div>
              <div class="days-bar-track">
                <div class="days-bar-attend" id="daysBarAttend" style="width:0%"></div>
                <div class="days-bar-friday" id="daysBarFriday" style="width:0%"></div>
                <div class="days-bar-leave" id="daysBarLeave" style="width:0%"></div>
                <div class="days-bar-absent" id="daysBarAbsent" style="width:0%"></div>
              </div>
              <div class="days-bar-legend">
                <span class="legend-item"><span class="legend-dot"
                    style="background:var(--accent-green)"></span>حضور</span>
                <span class="legend-item"><span class="legend-dot"
                    style="background:var(--accent-purple)"></span>جمعة</span>
                <span class="legend-item"><span class="legend-dot"
                    style="background:var(--accent-yellow)"></span>إجازة</span>
                <span class="legend-item"><span class="legend-dot"
                    style="background:var(--accent-red)"></span>غياب</span>
              </div>
            </div>

            <div class="form-grid form-grid-4">
              <div class="form-group">
                <label class="form-label">🟢 أيام الحضور</label>
                <input type="number" id="inpAttendance" class="form-input day-input day-attend" value="0" min="0"
                  max="31" oninput="validateDays(); recalculate();">
                <span class="form-hint">دوام عادي + سماحية + شيفت ليلي + عطلة</span>
              </div>
              <div class="form-group">
                <label class="form-label">🟣 أيام الجمعة العاملة</label>
                <input type="number" id="inpFridayDays" class="form-input day-input day-friday" value="0" min="0" max="5" oninput="recalculate()">
                <span class="form-hint">عدد أيام الجمعة التي داومها الموظف</span>
              </div>
              <div class="form-group">
                <label class="form-label">🟡 أيام الإجازة</label>
                <input type="number" id="inpLeaves" class="form-input day-input day-leave" value="0" min="0" max="31"
                  oninput="validateDays(); autoCalcEligibleFridays()">
                <span class="form-hint">غير مدفوعة الأجر (بدون مخصصات)</span>
              </div>
              <div class="form-group">
                <label class="form-label">🔴 أيام الغياب</label>
                <input type="number" id="inpAbsent" class="form-input day-input day-absent" value="0" min="0" max="31"
                  oninput="validateDays(); autoCalcEligibleFridays()">
                <span class="form-hint">خصم يوم (بدون مخصصات)</span>
              </div>
            </div>

            <h2 class="section-title" style="margin-top: 24px;">
              <span class="section-icon">📝</span>
              بيانات الإضافي والتأخير
            </h2>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">ساعات الإضافي</label>
                <input type="number" id="inpOvertime" class="form-input" value="0" min="0" step="0.5"
                  oninput="recalculate()">
                <span class="form-hint">×1.5 من سعر الساعة</span>
              </div>
              <div class="form-group">
                <label class="form-label">ساعات إضافي الجمعة</label>
                <input type="number" id="inpFridayOT" class="form-input" value="0" min="0" step="0.5"
                  oninput="recalculate()">
                <span class="form-hint">×2 من سعر الساعة</span>
              </div>
              <div class="form-group">
                <label class="form-label">ساعات التأخير</label>
                <input type="number" id="inpLateness" class="form-input" value="0" min="0" step="0.5"
                  oninput="recalculate()">
                <span class="form-hint">×2 من سعر الساعة</span>
              </div>
              <div class="form-group">
                <label class="form-label">جمعات مستحقة (تحسب تلقائياً)</label>
                <input type="number" id="inpFridays" class="form-input" value="4" min="0" max="4"
                  oninput="recalculate()">
                <span class="form-hint" id="inpFridaysHint">عدد الجمع المستحقة ÷ 4 (كل 6 أيام غياب/إجازة = جمعة أقل)</span>
              </div>
            </div>

            <h2 class="section-title" style="margin-top: 24px;">
              <span class="section-icon">💸</span>
              خصومات وإضافات
            </h2>
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">سلف الشهر الحالي</label>
                <div class="input-with-unit">
                  <input type="number" id="inpCurrentAdvance" class="form-input" value="0" min="0"
                    onchange="recalculate()">
                  <span class="input-unit">د.ع</span>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">الرصيد السابق (سلف سابقة)</label>
                <div class="input-with-unit">
                  <input type="number" id="inpPreviousAdvance" class="form-input" value="0" min="0"
                    onchange="recalculate()">
                  <span class="input-unit">د.ع</span>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">غرامات الالتزام (تُحسب تلقائياً)</label>
                <div class="input-with-unit">
                  <input type="number" id="inpPenalty" class="form-input" value="0" min="0" readonly>
                  <span class="input-unit">د.ع</span>
                </div>
                <span class="form-hint">التأخير + الغياب + الجمع المقتطعة</span>
              </div>
              <div class="form-group">
                <label class="form-label">المكافآت</label>
                <div class="input-with-unit">
                  <input type="number" id="inpBonus" class="form-input" value="0" min="0" onchange="recalculate()">
                  <span class="input-unit">د.ع</span>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">عقوبات وأضرار (من البيانات)</label>
                <div class="input-with-unit">
                  <input type="number" id="inpDamage" class="form-input" value="0" min="0" onchange="recalculate()">
                  <span class="input-unit">د.ع</span>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: Results -->
          <div class="calc-results">
            <!-- Month Info Card -->
            <div class="info-card glass-card">
              <h3 class="info-card-title">📅 معلومات الشهر</h3>
              <div class="info-grid">
                <div class="info-item">
                  <span class="info-label">إجمالي الأيام</span>
                  <span class="info-value" id="resTotalDays">31</span>
                </div>
                <div class="info-item">
                  <span class="info-label">أيام الجمعة</span>
                  <span class="info-value" id="resFridayCount">4</span>
                </div>
                <div class="info-item">
                  <span class="info-label">أيام العمل</span>
                  <span class="info-value" id="resWorkDays">27</span>
                </div>
                <div class="info-item">
                  <span class="info-label">سعر اليوم</span>
                  <span class="info-value" id="resDailyRate">0</span>
                </div>
                <div class="info-item">
                  <span class="info-label">سعر الساعة</span>
                  <span class="info-value" id="resHourlyRate">0</span>
                </div>
                <div class="info-item">
                  <span class="info-label">مخصصات/يوم</span>
                  <span class="info-value" id="resAllowanceRate">0</span>
                </div>
              </div>
            </div>

            <!-- Earnings Cards -->
            <div class="result-cards">
              <div class="result-card earn-card">
                <div class="result-card-icon">💵</div>
                <div class="result-card-content">
                  <span class="result-card-label">الراتب الأساسي</span>
                  <span class="result-card-value" id="resBaseSalary">0</span>
                </div>
              </div>
              <div class="result-card earn-card">
                <div class="result-card-icon">🚌</div>
                <div class="result-card-content">
                  <span class="result-card-label">المخصصات</span>
                  <span class="result-card-value" id="resAllowances">0</span>
                </div>
              </div>
              <div class="result-card earn-card">
                <div class="result-card-icon">⏰</div>
                <div class="result-card-content">
                  <span class="result-card-label">الإضافيات</span>
                  <span class="result-card-value" id="resOvertime">0</span>
                </div>
              </div>
              <div class="result-card earn-card">
                <div class="result-card-icon">📅</div>
                <div class="result-card-content">
                  <span class="result-card-label">تعويض الجمعة</span>
                  <span class="result-card-value" id="resFridayComp">0</span>
                </div>
              </div>
              <div class="result-card earn-card">
                <div class="result-card-icon">🎁</div>
                <div class="result-card-content">
                  <span class="result-card-label">المكافآت</span>
                  <span class="result-card-value" id="resBonusTotal">0</span>
                </div>
              </div>
            </div>

            <!-- Deductions Cards -->
            <div class="result-cards deduction-cards">
              <div class="result-card deduct-card">
                <div class="result-card-icon">⏱️</div>
                <div class="result-card-content">
                  <span class="result-card-label">خصم التأخيرات</span>
                  <span class="result-card-value deduct-value" id="resLatenessDeduct">0</span>
                </div>
              </div>
              <div class="result-card deduct-card">
                <div class="result-card-icon">🏖️</div>
                <div class="result-card-content">
                  <span class="result-card-label">خصم الإجازات</span>
                  <span class="result-card-value deduct-value" id="resLeaveDeduct">0</span>
                </div>
              </div>
              <div class="result-card deduct-card">
                <div class="result-card-icon">❌</div>
                <div class="result-card-content">
                  <span class="result-card-label">خصم الغيابات</span>
                  <span class="result-card-value deduct-value" id="resAbsenceDeduct">0</span>
                </div>
              </div>
              <div class="result-card deduct-card">
                <div class="result-card-icon">💳</div>
                <div class="result-card-content">
                  <span class="result-card-label">السلف + العقوبات + الأضرار</span>
                  <span class="result-card-value deduct-value" id="resOtherDeduct">0</span>
                </div>
              </div>
            </div>

            <!-- Payment Registration Section -->
            <div class="payment-section glass-card">
              <h3 class="section-title">
                <span class="section-icon">💰</span>
                تسجيل الدفع
              </h3>
              <div class="payment-form" style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
                  <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
                    <label class="form-label">مبلغ الدفع الفعلي</label>
                    <div class="input-with-unit">
                      <input type="number" id="inpPaymentAmount" class="form-input" value="0" min="0" oninput="window.paymentAmountManuallyEdited = true; updatePaymentChangeDisplay();">
                      <span class="input-unit">د.ع</span>
                    </div>
                  </div>
                  <div class="payment-quick-actions" style="display: flex; gap: 8px;">
                    <button class="btn-secondary" type="button" onclick="adjustPaymentAmount(1000)" style="padding: 10px 14px; font-weight: bold; border-radius: 8px; font-size: 13px;">+1,000</button>
                    <button class="btn-secondary" type="button" onclick="adjustPaymentAmount(5000)" style="padding: 10px 14px; font-weight: bold; border-radius: 8px; font-size: 13px;">+5,000</button>
                    <button class="btn-secondary" type="button" onclick="roundPaymentAmountTo1000()" style="padding: 10px 14px; font-weight: bold; border-radius: 8px; font-size: 13px; background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.2); color: var(--accent-blue);">تقريب لـ 1,000</button>
                  </div>
                  <button class="btn-primary" id="btnRegisterPayment" onclick="registerPayment()" style="height: 44px; margin-top: 0; padding: 0 20px;">
                    <span>✅</span> تسجيل الدفع
                  </button>
                </div>
                <!-- Dynamic Change/Rounding Info -->
                <div id="paymentChangeInfo" style="font-size: 12px; padding: 8px 12px; background: rgba(0,0,0,0.2); border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                  <span>الصافي المطلوب: <strong id="lblNetRequired">0 د.ع</strong></span>
                  <span id="lblCarryOverContainer">الخردة المرحّلة (الباقي): <strong id="lblChangeCarryOver" style="color: var(--accent-green);">0 د.ع</strong></span>
                </div>
              </div>
              <div class="payment-status" id="paymentStatus" style="display:none;"></div>
            </div>

            <!-- Salary Comparison Cards -->
            <div class="salary-cards-container">
              <!-- Card 1: Salary Due (Without Advances) -->
              <div class="salary-card glass-card salary-due-card">
                <div class="salary-header">
                  <span class="salary-icon">📋</span>
                  الراتب المستحق
                </div>
                <div class="salary-amount">
                  <span id="resSalaryDue">0</span>
                  <span class="final-currency">د.ع</span>
                </div>
                <div class="salary-breakdown">
                  <div class="breakdown-item">
                    <span>الراتب الأساسي:</span>
                    <span id="resSalaryDueBase">0</span>
                  </div>
                  <div class="breakdown-item">
                    <span>المخصصات:</span>
                    <span id="resSalaryDueAllowance">0</span>
                  </div>
                  <div class="breakdown-item">
                    <span>الإضافيات:</span>
                    <span id="resSalaryDueOvertime">0</span>
                  </div>
                  <div class="breakdown-item deduction">
                    <span>الخصومات (بدون سلف):</span>
                    <span id="resSalaryDueDeductions">0</span>
                  </div>
                </div>
              </div>

              <!-- Card 2: Current Balance (With All Deductions) -->
              <div class="salary-card glass-card current-balance-card">
                <div class="salary-header">
                  <span class="salary-icon">🏦</span>
                  الرصيد الحالي
                </div>
                <div class="salary-amount">
                  <span id="resCurrentBalance">0</span>
                  <span class="final-currency">د.ع</span>
                </div>
                <div class="salary-breakdown">
                  <div class="breakdown-item">
                    <span>الراتب المستحق:</span>
                    <span id="resCurrentBalanceBase">0</span>
                  </div>
                  <div class="breakdown-item deduction">
                    <span>السلف الحالية:</span>
                    <span id="resCurrentBalanceCurrentAdv">0</span>
                  </div>
                  <div class="breakdown-item deduction">
                    <span>الرصيد السابق:</span>
                    <span id="resCurrentBalancePrevAdv">0</span>
                  </div>
                  <div class="breakdown-item deduction">
                    <span>العقوبات والأضرار:</span>
                    <span id="resCurrentBalancePenaltyDamage">0</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Final Salary (Legacy - kept for compatibility) -->
            <div class="final-salary-card glass-card" id="finalSalaryCard">
              <div class="final-salary-label">
                <span class="final-icon">🏦</span>
                الراتب النهائي المستحق
              </div>
              <div class="final-salary-value" id="resFinalSalary">
                <span class="final-amount">0</span>
                <span class="final-currency">د.ع</span>
              </div>
              <div class="final-salary-bar">
                <div class="salary-bar-fill" id="salaryBarFill"></div>
              </div>
              <div class="final-salary-note">
                <span id="resSalaryPercent">0</span>% من الراتب الاسمي
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════ IMPORT DATA PAGE (Professional Redesign) ═══════════ -->
      <section class="page" id="pageImport">
        <div class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">
              <span class="title-icon">📥</span>
              مركز استيراد البيانات
            </h1>
            <p class="page-subtitle">نظام المعالجة الذكي لملفات البصمة والحضور</p>
          </div>
        </div>

        <div class="import-layout">
          <div class="import-sidebar">
            <div class="glass-card import-steps-card">
              <h3 class="step-title">خطوات العمل المنطقية</h3>
              <div class="import-step active" id="step1">
                <span class="step-num">1</span>
                <div class="step-text">
                  <strong>رفع الملف</strong>
                  <p>اختر ملف Excel من جهازك</p>
                </div>
              </div>
              <div class="import-step" id="step2">
                <span class="step-num">2</span>
                <div class="step-text">
                  <strong>المراجعة الأولية</strong>
                  <p>تأكد من قراءة الأسماء والتواريخ</p>
                </div>
              </div>
              <div class="import-step" id="step3">
                <span class="step-num">3</span>
                <div class="step-text">
                  <strong>التثبيت النهائي</strong>
                  <p>تصدير البيانات للتايم شيت</p>
                </div>
              </div>
            </div>

            <div class="glass-card info-card" style="margin-top: 20px;">
              <h4>💡 نصيحة احترافية</h4>
              <p style="font-size: 11px; line-height: 1.6; color: var(--text-muted); padding-top: 10px;">
                النظام يتعرف تلقائياً على الأعمدة (تاريخ، دخول، خروج، سلفة، غرامة). تأكد من أن أسماء الأوراق (Sheets)
                تمثل أسماء الموظفين بدقة.
              </p>
            </div>
          </div>

          <div class="import-main">
            <div class="glass-card upload-container-pro">
              <div class="upload-dropzone" id="dropzone" onclick="document.getElementById('timesheetFile').click()">
                <div class="dropzone-icon">📁</div>
                <h3>اسحب وأفلت الملف هنا أو انقر للاختيار</h3>
                <p>يدعم ملفات Excel و CSV فقط</p>
                <input type="file" id="timesheetFile" accept=".xlsx,.xls,.csv" style="display: none;"
                  onchange="uploadTimesheet()">
              </div>
              <div class="smart-mapping-actions">
                <label for="importAiInstructions" style="display:block; font-size:12px; color:var(--text-muted); margin-bottom:6px;">
                  <i class="fa-solid fa-robot" style="color:#a855f7;"></i> تعليمات للذكاء الاصطناعي (اختياري) — قل له شنو يحدّث وشنو يتجاهل:
                </label>
                <textarea id="importAiInstructions" rows="2"
                  placeholder="مثال: حدّث أيام الحضور والخروج فقط، لا تغيّر السلف أو الغرامات، وتجاهل ورقة الملخص..."
                  style="width:100%; margin-bottom:10px; padding:10px 12px; background:rgba(255,255,255,0.05); border:1px solid var(--border-glass); border-radius:8px; color:var(--text); font-family:inherit; font-size:13px; resize:vertical; box-sizing:border-box;"></textarea>
                <button class="btn-primary" onclick="smartMapImportFields()" type="button">
                  سحب الحقول بالذكاء الاصطناعي
                </button>
              </div>

              <div id="fileInfoArea" style="display: none; padding: 15px; border-top: 1px solid var(--border-glass);">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div id="selectedFileName" style="font-weight: 600; color: var(--accent-blue);"></div>
                  <button class="btn-primary" onclick="uploadTimesheet()" id="btnStartImport">
                    ابدأ المعالجة 🚀
                  </button>
                  <button class="btn-primary" onclick="smartMapImportFields()" id="btnSmartFieldMap">
                    سحب الحقول بالذكاء الاصطناعي
                  </button>
                </div>
              </div>
            </div>

            <div class="table-container glass-card" id="importedDataContainer" style="display:none; margin-top: 24px;">
              <div id="smartMappingPreview" class="smart-mapping-preview" style="display:none;"></div>
              <div class="table-header-pro">
                <h2 class="section-title" style="margin-bottom: 0;">
                  <span class="section-icon">📊</span>
                  نتائج الاستخراج الأولية
                </h2>
                <div class="filters-pro">
                  <select id="monthFilter" onchange="filterTableByMonth()" class="config-select">
                    <option value="">كل الأشهر</option>
                    <option value="01">يناير</option>
                    <option value="02">فبرابر</option>
                    <option value="03">مارس</option>
                    <option value="04">أبريل</option>
                    <option value="05">مايو</option>
                    <option value="06">يونيو</option>
                    <option value="07">يوليو</option>
                    <option value="08">أغسطس</option>
                    <option value="09">سبتمبر</option>
                    <option value="10">أكتوبر</option>
                    <option value="11">نوفمبر</option>
                    <option value="12">ديسمبر</option>
                  </select>
                </div>
              </div>

              <div class="responsive-table-wrapper">
                <table class="data-table" id="importedDataTable">
                  <thead>
                    <tr>
                      <th>الموظف (الورقة)</th>
                      <th>التاريخ</th>
                      <th>الدخول</th>
                      <th>الخروج</th>
                      <th>إضافيات</th>
                      <th>خصومات</th>
                      <th>الحالة الذكية</th>
                    </tr>
                  </thead>
                  <tbody id="importedDataBody"></tbody>
                </table>
              </div>
              <div style="display:flex; justify-content: flex-end; gap:10px; padding: 15px; border-top: 1px solid var(--border-glass); margin-top: 15px;">
                <button class="btn-success" onclick="saveImportedData()" id="btnSaveImport" style="background: #10b981; border: none; font-weight: bold; width: auto; padding: 10px 20px;">
                  <i class="fa-solid fa-check"></i> الحفظ والتحويل للتايم شيت الذكي
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ATTENDANCE CALENDAR PAGE -->
      <section class="page" id="pageCalendar">
        <div class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">
              <span class="title-icon">🗓️</span>
              تقويم الدوام الشهري
            </h1>
            <p class="page-subtitle">نظرة بانورامية شاملة لحضور الموظفين</p>
          </div>
          <div class="calendar-stats-mini">
            <div class="stat-mini-item">
              <span class="stat-label">إجمالي الساعات اليوم:</span>
              <span class="stat-value" id="calDailyTotalHours">0</span>
            </div>
            <div class="stat-mini-item">
              <span class="stat-label">الموظفون المتواجدون:</span>
              <span class="stat-value" id="calDailyActiveEmps">0</span>
            </div>
          </div>
        </div>

        <div class="glass-card calendar-container-pro">
          <div class="calendar-header-controls">
            <button class="btn-icon calendar-nav-btn" onclick="prevMonthCal()" title="الشهر السابق">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
            <h2 id="calHeaderMonthYear">مارس 2026</h2>
            <div class="calendar-actions">
              <button class="btn-icon calendar-today-btn" onclick="calendarJumpToday()" title="العودة إلى اليوم">
                <i class="fa-regular fa-calendar-check"></i>
                <span>اليوم</span>
              </button>
              <button class="btn-icon calendar-nav-btn" onclick="nextMonthCal()" title="الشهر التالي">
                <i class="fa-solid fa-chevron-left"></i>
              </button>
            </div>
          </div>

          <div class="calendar-grid-pro" id="attendanceCalendarGrid">
            <!-- Calendar days will be generated here -->
          </div>

          <div class="calendar-day-details" id="calDayDetails"></div>
        </div>
      </section>

      <!-- ═══════════ SMART TIMESHEET PAGE ═══════════ -->
      <section class="page" id="pageTimesheet">
        <div class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">
              <span class="title-icon">📋</span>
              التايم شيت المعالج
            </h1>
            <p class="page-subtitle">مراجعة وتحليل بيانات الحضور والغياب مع السماحية التلقائية</p>
          </div>
          <div class="page-header-actions" style="display: flex; gap: 10px;">
            <button class="btn-primary" onclick="printTimesheetForSelectedMonth()"
              style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
              <i class="fa-solid fa-print"></i> طباعة التايم شيت
            </button>
            <button class="btn-primary" onclick="autoFillMissingDays()"
              style="background: rgba(129, 140, 248, 0.2); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.3);">
              <span>🪄</span> تعبئة الأيام المفقودة
            </button>
            <button class="btn-primary" onclick="applyRulesNoAI()" id="btnApplyRulesNoAI"
              style="background: rgba(34, 211, 238, 0.2); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3);"
              title="تطبيق قوانين الشفت الليلي والتأخير والجمعة محلياً بدون استدعاء الذكاء الاصطناعي">
              <span>⚙️</span> تطبيق القوانين (محلياً)
            </button>
            <button class="btn-primary" onclick="addEmployee()">
              <span>➕</span> إضافة موظف
            </button>
          </div>
        </div>
        
        <div class="month-filter-bar glass-card" style="margin-bottom: 20px; padding: 15px 25px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <h3 style="font-size: 14px; margin: 0; color: var(--text-muted);"><i class="fa-regular fa-calendar-days"></i> تصفية حسب الشهر والسنة:</h3>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 13px; color: var(--text-muted);">السنة:</span>
              <select id="yearFilterSelect" onchange="changeYearFilter(this.value)" class="config-select" style="padding: 6px 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-glass); border-radius: 6px; color: var(--text); font-weight: bold; cursor: pointer;"></select>
            </div>
          </div>
          <div class="month-buttons" id="monthFilterButtons" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <!-- Buttons will be generated by JS -->
          </div>
        </div>

        <div class="emp-tabs-container" id="empTabsContainer" style="margin-bottom: 20px;">
          <div class="emp-tabs" id="empTabs"></div>
        </div>

        <div class="config-bar glass-card" id="empConfig" style="display: none; justify-content: space-between; align-items: center; margin-bottom: 20px; padding: 15px 25px;">
          <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center; width: 100%; justify-content: space-between;">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
              <div class="stat-mini-item">
                <span class="stat-label">أيام الحضور:</span>
                <span class="stat-value" id="empStatAttendance" style="color: var(--accent-green);">0</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">أيام الغياب:</span>
                <span class="stat-value" id="empStatAbsent" style="color: var(--accent-red);">0</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">حساب البدلات:</span>
                <span class="stat-value" id="empStatAllowances" style="color: #60a5fa;">0 د.ع</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">قيمة الإضافي:</span>
                <span class="stat-value" id="empStatOvertime" style="color: #fbbf24;">0 د.ع</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">مجموع الغرامات:</span>
                <span class="stat-value" id="empStatPenalties" style="color: #f87171;">0 د.ع</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">مستحقات الجمعة:</span>
                <span class="stat-value" id="empStatFridays" style="color: #c084fc;">0 د.ع</span>
              </div>
              <div class="stat-mini-item">
                <span class="stat-label">استهلاك سماحية التأخير:</span>
                <span class="stat-value" id="latenessGraceTotal" style="color: var(--accent-purple);">0 دقيقة من 100 دقيقة</span>
              </div>
            </div>
            <div class="stat-mini-item" style="border-right: 2px dashed rgba(255, 255, 255, 0.1); padding-right: 20px;">
              <span class="stat-label" style="font-weight: bold;">الصافي النهائي:</span>
              <span class="stat-value" id="empStatSalary" style="color: var(--accent-blue); font-size: 1.3em; font-weight: 800;">0 د.ع</span>
            </div>
          </div>
        </div>

        <div class="ai-assistant-bar glass-card" id="timesheetAIAssistant" style="display: none; flex-direction: column; margin-bottom: 20px; padding: 15px 25px; gap: 15px; border-right: 4px solid #a855f7;">
          <div style="display: flex; gap: 15px; align-items: center; width: 100%;">
            <div style="background: rgba(168, 85, 247, 0.1); padding: 12px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
              <i class="fa-solid fa-robot fa-2x" style="color: #a855f7;"></i>
            </div>
            <div style="flex: 1;">
              <label style="font-size: 11px; margin-bottom: 6px; display: block; color: var(--text-muted); font-weight: bold;">مساعد الذكاء الاصطناعي الذكي (أوامر التعديل)</label>
              <input type="text" id="aiCustomPrompt" class="form-input" placeholder="اكتب أمرك هنا... مثلاً: 'اجعل غيابات يوم الخميس إجازات'" style="width: 100%; border: 1px solid rgba(168, 85, 247, 0.3); background: rgba(0,0,0,0.2);">
            </div>
            <div style="display: flex; gap: 10px; margin-top: 20px;">
              <button class="btn-primary" onclick="processTimesheetWithAI()" id="btnProcessTimesheetAI" style="background: linear-gradient(135deg, #a855f7, #ec4899); border: none; font-weight: bold; white-space: nowrap; height: 42px; border-radius: 8px;">
                <i class="fa-solid fa-paper-plane"></i> إرسال الأمر
              </button>
              <button class="btn-primary" onclick="applyComplexRulesWithAI()" id="btnApplyRulesAI" style="background: linear-gradient(135deg, #ec4899, #f43f5e); border: none; font-weight: bold; white-space: nowrap; height: 42px; border-radius: 8px;" title="يطبق قوانين الشفت الليلي والجمعة والتأخيرات آلياً">
                <i class="fa-solid fa-scale-balanced"></i> تطبيق قوانين الرواتب
              </button>
            </div>
          </div>
          
          <!-- AI Response Chat Bubble -->
          <div id="aiResponseBox" style="display: none; background: rgba(168, 85, 247, 0.05); border-radius: 12px; padding: 15px 20px; border: 1px solid rgba(168, 85, 247, 0.2); position: relative; align-self: flex-start; width: 100%;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <i class="fa-solid fa-sparkles" style="color: #a855f7; margin-top: 4px;"></i>
              <div>
                <strong style="color: #a855f7; font-size: 13px; display: block; margin-bottom: 5px;">رد المساعد الذكي:</strong>
                <span id="aiResponseText" style="color: #e2e8f0; font-size: 14px; line-height: 1.6;"></span>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- ═══════════ REPORT PAGE ═══════════ -->
  <section class="page" id="pageReport">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">📊</span> التقرير النهائي</h1>
        <p class="page-subtitle">عرض تفصيلي لراتب كل موظف مع إمكانية تصدير PDF</p>
      </div>
    </div>
    <div class="emp-tabs-container page-tabs-toolbar" id="reportEmpTabsContainer" style="margin-bottom: 20px;">
      <div class="emp-tabs" id="reportEmpTabs"></div>
      <div class="page-tabs-actions">
        <button class="btn-primary" onclick="prepareSmartReportSummary()">
          <i class="fa-solid fa-wand-magic-sparkles"></i> إعداد ملخص ذكي للتقرير
        </button>
        <button class="btn-primary" onclick="window.print()">
          <i class="fa-solid fa-print"></i> طباعة
        </button>
        <button class="btn-primary" onclick="exportPayrollPdf()">
          <i class="fa-solid fa-file-pdf"></i> تصدير التقرير
        </button>
      </div>
    </div>
    <div class="report-period-bar glass-card" id="reportPeriodBar">
      <label>الفترة المعروضة</label>
      <select id="reportPeriodMode" class="form-input" onchange="renderReport()">
        <option value="current_month">الشهر الحالي / المحدد</option>
        <option value="last_30">آخر 30 يوم</option>
        <option value="all">كل البيانات</option>
      </select>
      <span id="reportPeriodLabel">-</span>
    </div>
    <div class="report-smart-summary glass-card" id="reportSmartSummary" style="display:none;"></div>
    <div class="report-content" id="reportContent" style="display:none;">
      <div class="report-table-card glass-card">
        <table class="report-table">
          <tbody id="reportTableBody"></tbody>
        </table>
      </div>
    </div>
    <div class="empty-state" id="reportEmpty">
      <div class="empty-icon">📊</div>
      <h3>لا توجد بيانات حضور</h3>
      <p>قم باستيراد ملف الإكسل لتوليد التقرير</p>
    </div>
  </section>

  <!-- ═══════════ EMPLOYEES & BALANCES PAGE ═══════════ -->
  <section class="page" id="pageEmployees">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">👥</span> الموظفين والأرصدة</h1>
        <p class="page-subtitle">إدارة سجلات الموظفين والحالات المالية</p>
      </div>
    </div>
    <div class="emp-tabs-container page-tabs-toolbar employees-toolbar" style="margin-bottom: 20px;">
      <div class="emp-tabs">
        <span class="employees-section-heading">قائمة الموظفين</span>
      </div>
      <div class="page-tabs-actions">
        <button class="btn-primary" onclick="renderEmployeesTable()">
          <i class="fa-solid fa-rotate"></i> تحديث
        </button>
        <button class="btn-primary" onclick="exportData()">
          <i class="fa-solid fa-download"></i> تصدير البيانات
        </button>
      </div>
    </div>
    <div class="table-container glass-card" id="employeesTableContainer">
      <table class="employees-table">
        <thead>
          <tr>
            <th onclick="sortEmployeesTable('name')" class="employee-sortable">اسم الموظف <span class="sort-arrow" id="sortArrowName"></span></th>
            <th onclick="sortEmployeesTable('salary')" class="employee-sortable">الراتب الاسمي <span class="sort-arrow" id="sortArrowSalary"></span></th>
            <th>الشفت</th>
            <th onclick="sortEmployeesTable('lastActivity')" class="employee-sortable">آخر نشاط <span class="sort-arrow" id="sortArrowLastActivity"></span></th>
            <th onclick="sortEmployeesTable('status')" class="employee-sortable employee-status-head">الحالة <span class="sort-arrow" id="sortArrowStatus"></span><input class="employee-active-only-check" type="checkbox" title="عرض الفعالين فقط" onchange="event.stopPropagation(); toggleActiveEmployeesOnly(this.checked)"></th>
            <th onclick="sortEmployeesTable('balance')" class="employee-sortable">الرصيد الحالي <span class="sort-arrow" id="sortArrowBalance"></span></th>
            <th>إجراءات</th>
          </tr>
        </thead>
        <tbody id="employeesTableBody"></tbody>
      </table>
    </div>
    <div class="empty-state" id="employeesEmpty">
       <div class="empty-icon">👥</div>
       <h3>قائمة الموظفين فارغة</h3>
       <p>سيتم ظهور الموظفين هنا تلقائياً عند استيراد البيانات</p>
    </div>
  </section>

  <!-- ═══════════ EMPLOYEE UI (DUAL UI LAYER) ═══════════ -->
  <section class="page" id="pageFinance">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">💹</span> الداشبورد المالي</h1>
        <p class="page-subtitle">كل حركة مالية تدخل هنا حتى تبقى القاصة، الرواتب، العملاء، والواردات مربوطة بنفس الدفتر</p>
      </div>
      <div class="page-header-actions"><button class="btn-primary finance-demo-action" onclick="addFinanceDemoData('finance')">إضافة أمثلة تجريبية</button></div>
    </div>
    <div class="finance-tab-bar">
      <button class="finance-tab active" data-tab="dashboard" onclick="switchFinanceTab('dashboard')">لوحة التحكم</button>
      <button class="finance-tab" data-tab="journal" onclick="switchFinanceTab('journal')">القيود اليومية</button>
      <button class="finance-tab" data-tab="trial_balance" onclick="switchFinanceTab('trial_balance')">ميزان المراجعة</button>
      <button class="finance-tab" data-tab="pl" onclick="switchFinanceTab('pl')">الأرباح والخسائر</button>
      <button class="finance-tab" data-tab="ledger" onclick="switchFinanceTab('ledger')">دفتر الأستاذ</button>
    </div>
    <div id="financeTabContent">
    <div id="financeTab-dashboard">
    <div class="finance-kpi-grid">
      <div class="finance-kpi glass-card"><span>رصيد قاصة الورشة</span><strong id="financeCashBalance">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>إجمالي الواردات</span><strong id="financeIncomeTotal">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>إجمالي الصادرات</span><strong id="financeExpenseTotal">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>صافي حركة اليوم</span><strong id="financeTodayNet">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>الرواتب المدفوعة</span><strong id="financePayrollPaid">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>ذمم العملاء</span><strong id="financeCustomerBalances">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>مصروفات الورشة</span><strong id="financeWorkshopExpenses">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>الصافي العام</span><strong id="financeNetBalance">0 د.ع</strong></div>
    </div>
    <div class="finance-two-col">
      <div class="table-container glass-card">
        <h3 class="section-title">آخر الحركات</h3>
        <table class="data-table finance-table">
          <thead><tr><th>التاريخ</th><th>النوع</th><th>الوصف</th><th>القسم</th><th>الطرف</th><th>المبلغ</th></tr></thead>
          <tbody id="financeRecentBody"></tbody>
        </table>
      </div>
      <div class="glass-card finance-panel">
        <h3 class="section-title">الشجرة الحسابية المختصرة</h3>
        <div id="chartAccountsList" class="account-list"></div>
        <h3 class="section-title" style="margin-top:18px;">أرصدة الأشخاص</h3>
        <div id="peopleBalancesList" class="account-list"></div>
        <h3 class="section-title" style="margin-top:18px;">ملخص حسب القسم</h3>
        <div id="departmentSummaryList" class="account-list"></div>
      </div>
    </div>
    </div><!-- /financeTab-dashboard -->
    <div id="financeTab-journal" style="display:none"></div>
    <div id="financeTab-trial_balance" style="display:none"></div>
    <div id="financeTab-pl" style="display:none"></div>
    <div id="financeTab-ledger" style="display:none"></div>
    </div><!-- /financeTabContent -->
  </section>

  <section class="page" id="pageCashbox">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">🏦</span> قاصة الورشة</h1>
        <p class="page-subtitle">حركة يومية حسب التاريخ، والرصيد العام ظاهر بالأعلى</p>
      </div>
      <div class="page-header-actions" style="display:flex; gap:8px">
        <button class="btn-primary" onclick="openCashboxTransactionModal()"><i class="fa-solid fa-plus"></i> إضافة حركة نقدية</button>
        <button class="btn-secondary finance-demo-action" onclick="addFinanceDemoData('cashbox')">إضافة بيانات تجريبية</button>
      </div>
    </div>
    <div class="cashbox-hero glass-card">
      <span>الرصيد الحالي</span>
      <strong id="cashboxBalanceTop">0 د.ع</strong>
    </div>
    <div class="finance-filter-bar glass-card cashbox-date-controls">
      <label>تاريخ الحركة</label>
      <button class="cashbox-date-nav" onclick="shiftCashboxDate(-1)" title="اليوم السابق">›</button>
      <button class="cashbox-today-btn" onclick="setCashboxToday()">اليوم</button>
      <input type="date" class="form-input" id="cashboxDate" onchange="renderCashbox()">
      <button class="cashbox-date-nav" onclick="shiftCashboxDate(1)" title="اليوم التالي">‹</button>
    </div>
    <div class="finance-kpi-grid compact">
      <div class="finance-kpi glass-card"><span>داخل</span><strong class="finance-in" id="cashboxDateIn">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>خارج</span><strong class="finance-out" id="cashboxDateOut">0 د.ع</strong></div>
      <div class="finance-kpi glass-card"><span>صافي اليوم</span><strong id="cashboxDateNet">0 د.ع</strong></div>
    </div>
    <div class="table-container glass-card">
      <table class="data-table finance-table">
        <thead><tr><th>التاريخ</th><th>الاتجاه</th><th>الوصف</th><th>الطرف</th><th>المبلغ</th></tr></thead>
        <tbody id="cashboxBody"></tbody>
      </table>
    </div>
  </section>

  <section class="page" id="pageExpenses">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">📤</span> المصروفات</h1>
        <p class="page-subtitle">حدد صنف الصادر ومصدر الدفع: قاصة الورشة أو شخص دفع من جيبه فينضاف لرصيده</p>
      </div>
      <div class="page-header-actions"><button class="btn-primary finance-demo-action" onclick="addFinanceDemoData('expenses')">إضافة أمثلة تجريبية</button></div>
    </div>
    <div class="finance-entry-grid">
      <div class="glass-card finance-form-card">
        <h3 class="section-title">تسجيل مصروف</h3>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">التاريخ</label><input type="date" id="expenseDate" class="form-input"></div>
          <div class="form-group"><label class="form-label">المبلغ</label><input type="number" id="expenseAmount" class="form-input" min="0"></div>
          <div class="form-group"><label class="form-label">الصنف</label><select id="expenseCategory" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">القسم</label><select id="expenseDepartment" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">مصدر الدفع</label><select id="expenseSource" class="form-input" onchange="onExpenseSourceChange()"><option value="cashbox">قاصة الورشة</option><option value="person_pocket">شخص دفع من جيبه</option></select></div>
          <div class="form-group" id="expensePersonWrap" style="display:none;"><label class="form-label">الشخص</label><select id="expensePerson" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">الوصف</label><input type="text" id="expenseDescription" class="form-input" placeholder="مثال: شراء مواد، صيانة، نقل"></div>
        </div>
        <button class="btn-primary finance-submit-action" id="expenseSubmitBtn" onclick="addExpenseFromForm()">تسجيل المصروف</button>
      </div>
      <div class="glass-card finance-form-card finance-setup-note-card">
        <h3 class="section-title">إعدادات المصروفات</h3>
        <p>إدارة الأقسام والأشخاص والأصناف من لوحة الأدمن.</p>
        <button class="btn-secondary" onclick="switchPage('admin_panel')">فتح لوحة الأدمن</button>
      </div>
    </div>
    <div class="table-container glass-card">
      <table class="data-table finance-table">
        <thead><tr><th>التاريخ</th><th>الصنف</th><th>القسم</th><th>الوصف</th><th>الدفع</th><th>المبلغ</th></tr></thead>
        <tbody id="expensesBody"></tbody>
      </table>
    </div>
  </section>

  <section class="page" id="pageIncome">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">📥</span> الواردات</h1>
        <p class="page-subtitle">أي قبض يدخل القاصة ويظهر فوراً بالداشبورد وحركة اليوم</p>
      </div>
      <div class="page-header-actions"><button class="btn-primary finance-demo-action" onclick="addFinanceDemoData('income')">إضافة أمثلة تجريبية</button></div>
    </div>
    <div class="finance-entry-grid">
      <div class="glass-card finance-form-card">
        <h3 class="section-title">تسجيل وارد</h3>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">التاريخ</label><input type="date" id="incomeDate" class="form-input"></div>
          <div class="form-group"><label class="form-label">المبلغ</label><input type="number" id="incomeAmount" class="form-input" min="0"></div>
          <div class="form-group"><label class="form-label">الصنف</label><select id="incomeCategory" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">القسم</label><select id="incomeDepartment" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">العميل</label><select id="incomeCustomer" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">الوصف</label><input type="text" id="incomeDescription" class="form-input" placeholder="مثال: دفعة مشروع، تسديد عميل"></div>
        </div>
        <button class="btn-primary finance-submit-action" id="incomeSubmitBtn" onclick="addIncomeFromForm()">تسجيل الوارد</button>
      </div>
      <div class="glass-card finance-form-card finance-setup-note-card">
        <h3 class="section-title">إعدادات الواردات</h3>
        <p>إدارة الأقسام والأشخاص والمصادر من لوحة الأدمن.</p>
        <button class="btn-secondary" onclick="switchPage('admin_panel')">فتح لوحة الأدمن</button>
      </div>
    </div>
    <div class="table-container glass-card">
      <table class="data-table finance-table">
        <thead><tr><th>التاريخ</th><th>الصنف</th><th>القسم</th><th>الوصف</th><th>الطرف</th><th>المبلغ</th></tr></thead>
        <tbody id="incomeBody"></tbody>
      </table>
    </div>
  </section>

  <section class="page" id="pageCustomers">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">🧾</span> أرصدة العملاء</h1>
        <p class="page-subtitle">رصيد افتتاحي، مطالبات، وتسديدات من صفحة الواردات</p>
      </div>
      <div class="page-header-actions"><button class="btn-primary finance-demo-action" onclick="addFinanceDemoData('customers')">إضافة أمثلة تجريبية</button></div>
    </div>
    <div class="finance-entry-grid">
      <div class="glass-card finance-form-card">
        <h3 class="section-title">إضافة عميل</h3>
        <div class="form-grid">
          <input id="customerName" class="form-input" placeholder="اسم العميل">
          <input id="customerCompany" class="form-input" placeholder="اسم الشركة">
          <input id="customerShop" class="form-input" placeholder="اسم المحل">
          <input id="customerPhone" class="form-input" placeholder="هاتف">
          <input id="customerOpening" type="number" class="form-input" placeholder="رصيد افتتاحي بذمته">
          <input id="customerNotes" class="form-input" placeholder="ملاحظات">
        </div>
        <button class="btn-primary" onclick="addCustomerFromForm()">إضافة العميل</button>
      </div>
      <div class="glass-card finance-form-card">
        <h3 class="section-title">إضافة مطالبة على عميل</h3>
        <div class="form-grid">
          <input type="date" id="customerChargeDate" class="form-input">
          <select id="customerChargeSelect" class="form-input"></select>
          <select id="customerChargeDepartment" class="form-input"></select>
          <input id="customerChargeAmount" type="number" class="form-input" placeholder="المبلغ">
          <input id="customerChargeDescription" class="form-input" placeholder="سبب المطالبة">
        </div>
        <button class="btn-primary" onclick="addCustomerCharge()">إضافة على الرصيد</button>
      </div>
    </div>
    <div class="table-container glass-card">
      <table class="data-table finance-table">
        <thead><tr><th>العميل</th><th>الشركة</th><th>المحل</th><th>الهاتف</th><th>الافتتاحي</th><th>الحالي</th><th>الاتجاه</th><th>ملاحظات</th></tr></thead>
        <tbody id="customersBody"></tbody>
      </table>
    </div>
  </section>

  <section class="page" id="pageReceipt">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">🖨️</span> الوصلات</h1>
        <p class="page-subtitle">إدارة وصل قبض، وصل صرف، ووصل مبيعات مع ترحيل مالي آمن بدون تكرار</p>
      </div>
      <div class="page-header-actions"><button class="btn-primary finance-demo-action" onclick="addFinanceDemoData('receipts')">إضافة أمثلة تجريبية</button></div>
    </div>
    <div class="receipt-workspace">
      <div class="glass-card finance-form-card">
        <div class="form-grid">
          <div class="form-group"><label class="form-label">نوع الوصل</label><select id="receiptKind" class="form-input" onchange="renderReceiptPage()"><option value="income">وصل قبض</option><option value="expense">وصل صرف</option><option value="sales">وصل مبيعات</option></select></div>
          <div class="form-group"><label class="form-label">رقم الوصل</label><input id="receiptNo" class="form-input" placeholder="رقم الوصل" oninput="updateReceiptPreview()"></div>
          <div class="form-group"><label class="form-label">التاريخ</label><input type="date" id="receiptDate" class="form-input" onchange="updateReceiptPreview()"></div>
          <div class="form-group"><label class="form-label">المبلغ الإجمالي</label><input id="receiptAmount" type="number" class="form-input" placeholder="المبلغ الإجمالي" oninput="updateReceiptPreview()"></div>
          <div class="form-group"><label class="form-label">المدفوع</label><input id="receiptPaidAmount" type="number" class="form-input" placeholder="المدفوع" oninput="updateReceiptPreview()"></div>
          <div class="form-group"><label class="form-label">الطريقة</label><select id="receiptPaymentMethod" class="form-input" onchange="updateReceiptPreview()"><option value="cash">نقداً</option><option value="bank">تحويل/مصرف</option><option value="ledger">قيد فقط</option></select></div>
          <div class="form-group"><label class="form-label">عميل اختياري</label><select id="receiptCustomer" class="form-input" onchange="updateReceiptPreview()"></select></div>
          <div class="form-group"><label class="form-label">الصنف</label><select id="receiptCategory" class="form-input"></select></div>
          <div class="form-group"><label class="form-label">القسم</label><select id="receiptDepartment" class="form-input" onchange="updateReceiptPreview()"></select></div>
          <div class="form-group"><label class="form-label">الطرف / المستلم / الدافع</label><input id="receiptParty" class="form-input" placeholder="اكتب أي طرف بحرية" oninput="updateReceiptPreview()"></div>
          <div class="form-group"><label class="form-label">التفاصيل</label><input id="receiptDescription" class="form-input" placeholder="التفاصيل العامة" oninput="updateReceiptPreview()"></div>
        </div>
        <div class="receipt-items-editor">
          <h3 class="section-title">بنود وصل المبيعات</h3>
          <div class="receipt-item-inputs">
            <input id="receiptItemName" class="form-input" placeholder="البند / السلعة">
            <input id="receiptItemDesc" class="form-input" placeholder="الوصف">
            <input id="receiptItemQty" type="number" class="form-input" min="0" step="0.01" placeholder="العدد">
            <input id="receiptItemUnit" class="form-input" placeholder="الوحدة">
            <input id="receiptItemPrice" type="number" class="form-input" min="0" step="0.01" placeholder="سعر الوحدة">
            <input id="receiptItemDetails" class="form-input" placeholder="اللون / التفاصيل">
            <button class="btn-primary" onclick="addReceiptLineItem()">إضافة بند</button>
          </div>
          <div id="receiptItemsTable" class="receipt-items-table"></div>
        </div>
        <div class="receipt-actions">
          <button class="btn-primary" onclick="updateReceiptPreview()">تحديث الوصل</button>
          <button class="btn-primary" onclick="saveReceiptFromForm()">حفظ وتسجيل الحركة</button>
          <button class="btn-primary" onclick="printFinanceReceipt()">طباعة</button>
        </div>
      </div>
      <div class="receipt-paper glass-card" id="receiptPreview" contenteditable="true"></div>
    </div>
    <div class="table-container glass-card receipt-ledger" style="margin-top:20px;">
      <h3 class="section-title">الوصلات المحفوظة</h3>
      <table class="data-table finance-table">
        <thead><tr><th>الرقم</th><th>التاريخ</th><th>النوع</th><th>الطرف</th><th>الوصف</th><th>الإجمالي</th><th>المدفوع</th><th>المتبقي</th><th>الدفع</th><th>الحالة</th></tr></thead>
        <tbody id="savedReceiptsBody"></tbody>
      </table>
    </div>
  </section>

  <section class="page" id="pageEmployee_ui">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">🧑‍🔧</span> لوحة الموظف</h1>
        <p class="page-subtitle">واجهة الموظف اليومية: المهام، الدوام، الراتب، الطلبات</p>
      </div>
