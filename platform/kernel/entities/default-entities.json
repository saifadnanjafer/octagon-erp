{
  "product_category": {
    "id": "product_category",
    "module_id": "platform_kernel",
    "storage_owner": "platform.data.repositories",
    "primary_key": "id",
    "label_ar": "فئة المنتج",
    "label_en": "Product Category",
    "section": "supply",
    "sequence": "CAT-{#####}",
    "seq_field": "seq",
    "chatter": false,
    "acl": "supply:product_category",
    "status_key": "status",
    "fields": {
      "name": { "type": "text", "label_ar": "الاسم", "required": true },
      "code": { "type": "text", "label_ar": "الرمز" },
      "description": { "type": "textarea", "label_ar": "الوصف" },
      "status": { "type": "select", "label_ar": "الحالة", "options": ["active", "inactive"], "default": "active" }
    },
    "relations": {},
    "scope": "company",
    "lifecycle_policy": "generic",
    "query_policy": "scoped",
    "action_policy": "registered",
    "customization_policy": "metadata",
    "history_policy": "audit",
    "api_exposed": true,
    "migration_owner": "platform.kernel"
  },
  "product": {
    "id": "product",
    "module_id": "platform_kernel",
    "storage_owner": "platform.data.repositories",
    "primary_key": "id",
    "label_ar": "منتج",
    "label_en": "Product",
    "section": "supply",
    "sequence": "PRD-{#####}",
    "seq_field": "seq",
    "chatter": true,
    "acl": "supply:product",
    "status_key": "status",
    "fields": {
      "name": { "type": "text", "label_ar": "اسم المنتج", "required": true },
      "sku": { "type": "text", "label_ar": "رمز المنتج" },
      "category_id": { "type": "reference", "label_ar": "فئة المنتج" },
      "uom": { "type": "text", "label_ar": "وحدة القياس", "default": "قطعة" },
      "cost_price": { "type": "number", "label_ar": "سعر الكلفة" },
      "sale_price": { "type": "number", "label_ar": "سعر البيع" },
      "status": { "type": "select", "label_ar": "الحالة", "options": ["active", "inactive"], "default": "active" }
    },
    "relations": {
      "category": {
        "type": "belongs_to",
        "target": "product_category",
        "foreign_key": "category_id",
        "cardinality": "one",
        "inverse": "products"
      }
    },
    "scope": "company",
    "lifecycle_policy": "generic",
    "query_policy": "scoped",
    "action_policy": "registered",
    "customization_policy": "metadata",
    "history_policy": "audit",
    "api_exposed": true,
    "migration_owner": "platform.kernel"
  },
  "crm_lead": {
    "id": "crm_lead",
    "module_id": "platform_kernel",
    "storage_owner": "platform.data.repositories",
    "primary_key": "id",
    "label_ar": "عميل محتمل",
    "label_en": "CRM Lead",
    "section": "sales",
    "sequence": "LEAD-{YYYY}-{#####}",
    "seq_field": "seq",
    "chatter": true,
    "acl": "sales:crm_lead",
    "status_key": "status",
    "fields": {
      "name": { "type": "text", "label_ar": "الاسم", "required": true },
      "company": { "type": "text", "label_ar": "الشركة" },
      "phone": { "type": "phone", "label_ar": "الهاتف" },
      "email": { "type": "email", "label_ar": "البريد الإلكتروني" },
      "source": { "type": "select", "label_ar": "المصدر", "options": ["موقع", "إحالة", "اتصال بارد", "معرض", "أخرى"] },
      "status": { "type": "select", "label_ar": "الحالة", "options": ["new", "contacted", "qualified", "won", "lost"], "default": "new" },
      "owner": { "type": "text", "label_ar": "المسؤول" },
      "value": { "type": "number", "label_ar": "القيمة المتوقعة" },
      "notes": { "type": "textarea", "label_ar": "ملاحظات" }
    },
    "relations": {},
    "scope": "company",
    "lifecycle_policy": "workflow",
    "query_policy": "scoped",
    "action_policy": "registered",
    "customization_policy": "metadata",
    "history_policy": "audit",
    "api_exposed": true,
    "migration_owner": "platform.kernel"
  },
  "helpdesk_ticket": {
    "id": "helpdesk_ticket",
    "module_id": "platform_kernel",
    "storage_owner": "platform.data.repositories",
    "primary_key": "id",
    "label_ar": "تذكرة دعم",
    "label_en": "Helpdesk Ticket",
    "section": "sales",
    "sequence": "TKT-{YYYY}{MM}-{####}",
    "seq_field": "seq",
    "chatter": true,
    "acl": "support:helpdesk_ticket",
    "status_key": "status",
    "fields": {
      "subject": { "type": "text", "label_ar": "الموضوع", "required": true },
      "customer": { "type": "text", "label_ar": "العميل" },
      "priority": { "type": "select", "label_ar": "الأولوية", "options": ["low", "medium", "high", "urgent"], "default": "medium" },
      "status": { "type": "select", "label_ar": "الحالة", "options": ["open", "in_progress", "waiting", "resolved", "closed"], "default": "open" },
      "assignee": { "type": "text", "label_ar": "المكلَّف" },
      "body": { "type": "textarea", "label_ar": "الوصف" }
    },
    "relations": {},
    "scope": "company",
    "lifecycle_policy": "workflow",
    "query_policy": "scoped",
    "action_policy": "registered",
    "customization_policy": "metadata",
    "history_policy": "audit",
    "api_exposed": true,
    "migration_owner": "platform.kernel"
  }
}
