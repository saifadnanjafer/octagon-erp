  <!-- ═══════════ OPERATION PACKS ═══════════ -->
  <section class="page" id="pageOpPacks">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">📦</span> باقات العمليات</h1>
        <p class="page-subtitle">صمّم نوع شغل مرّة، استخدمه لكل عميل جديد</p>
      </div>
      <div class="page-header-actions">
        <button class="btn-primary" onclick="addOpPack()"><i class="fa-solid fa-plus"></i> باقة جديدة</button>
        </div>
    </div>

    <div class="op-packs-concept-card">
      <p class="op-packs-concept-tagline"><i class="fa-solid fa-lightbulb"></i> <b>الباقة وصفة شغل جاهزة.</b> صمّمها مرّة → استخدمها لكل عميل من نفس النوع. لو احتجت نوع جديد مشابه: انسخ باقة موجودة وعدّلها.</p>
      <div class="op-packs-concept-flow">
        <div class="op-packs-concept-step">
          <span class="op-packs-concept-num">1</span>
          <b>اختر باقة من مكتبتك</b>
          <small>أو انسخ باقة موجودة وعدّلها، أو ابدأ واحدة جديدة فاضية</small>
        </div>
        <div class="op-packs-concept-arrow"><i class="fa-solid fa-arrow-left"></i></div>
        <div class="op-packs-concept-step">
          <span class="op-packs-concept-num">2</span>
          <b>أدخل اسم العميل + المقاس</b>
          <small>الباقة تحسب الكلفة والوقت الحقيقي بناءً على مقاس الشغل</small>
        </div>
        <div class="op-packs-concept-arrow"><i class="fa-solid fa-arrow-left"></i></div>
        <div class="op-packs-concept-step">
          <span class="op-packs-concept-num">3</span>
          <b>بطاقات Kanban تلقائياً</b>
          <small>فريقك يفتح لوحة Kanban ويبدأ الشغل مباشرة</small>
        </div>
      </div>
    </div>

    <div class="op-packs-grid" id="opPacksGrid"></div>
  </section>

