    </div>
    <div id="employeePortalBody"></div>
  </section>

  <!-- ═══════════ WORKFLOW STUDIO (PIPELINES) ═══════════ -->
  <section class="page" id="pageWorkflow">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">🔀</span> Workflow & Pipeline Designer</h1>
        <p class="page-subtitle">Canvas شبيه n8n: اسحب عقدة، اربطها، وخلي كل خطوة مرتبطة بـ SOP واضح</p>
      </div>
      <div class="page-header-actions">
        <div class="workflow-header-summary" id="workflowSummary"></div>
        <button class="btn-primary" onclick="runWorkflowSimulation()"><i class="fa-solid fa-vial"></i> Test Run & Validate</button>
        <button class="btn-primary" style="background:var(--accent-green)" onclick="publishWorkflow()"><i class="fa-solid fa-check-circle"></i> نشر (Publish)</button>
        <button class="btn-secondary" onclick="triggerWorkflowExecution()"><i class="fa-solid fa-rocket"></i> تنفيذ سير العمل</button>
        <button class="btn-primary" onclick="addWorkflowNode()">إضافة Node</button>
        <button class="btn-primary" onclick="clearWorkflowSelection()">إلغاء الربط</button>
      </div>
    </div>
    <div class="workflow-studio-shell">
      <aside class="workflow-palette glass-card">
        <h3 class="section-title">Node Palette</h3>
        <div id="workflowPalette"></div>
      </aside>
      <div class="workflow-canvas glass-card" id="workflowCanvas" ondragover="event.preventDefault()" ondrop="workflowCanvasDrop(event)"></div>
    </div>
  </section>

  <!-- ═══════════ KANBAN BOARD ═══════════ -->
  <section class="page" id="pageKanban" style="padding:10px;">
    <div class="page-header">
      <div class="page-header-text">
        <h1 class="page-title"><span class="title-icon">📋</span> اللوحة التنفيذية</h1>
        <p class="page-subtitle">Trello-style board: أعمدة قابلة للإضافة، بطاقات بالسحب والإفلات، أولوية، مسؤول، موعد، Tags وChecklist</p>
      </div>
      <div class="page-header-actions" style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button class="btn-secondary" onclick="toggleKanbanView()"><i class="fa-solid fa-list"></i> تغيير العرض</button>
        <button class="btn-primary" onclick="addKanbanColumn()">إضافة عمود</button>
        <button class="btn-primary" onclick="addKanbanCard()">إضافة بطاقة</button>
      </div>
    </div>
    <div class="omni-kanban-board" id="omniKanbanBoard"></div>
  </section>

  <section class="page" id="pageTaskManager">
