  <div id="omniModalOverlay" style="position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.6); backdrop-filter:blur(5px); z-index:30000; display:none; align-items:center; justify-content:center;">
    <div id="omniModalBox" class="glass-card" style="width:400px; max-width:90vw; padding:25px; border-radius:15px; display:flex; flex-direction:column; gap:15px; box-shadow:0 15px 50px rgba(0,0,0,0.5);">
