# OCTAGON ERP — environment template (Security Hardening Sprint 2026-07-05)
# Copy to .env and fill in REAL values. NEVER commit .env.
# API keys must NEVER appear in client JS — the server proxy is the only consumer.

# Custom OpenAI-Compatible API (optional)
CUSTOM_API_KEY=your-custom-api-key-here
CUSTOM_API_ENDPOINT=https://api.example.com/v1
CUSTOM_API_PROVIDER=contactbox
CUSTOM_API_MODEL=claude-sonnet-4-6

# Node.js Server Config
NODE_ENV=production
PORT=8080

# AI provider keys (consumed ONLY by server.js → server-jarvis-security.js)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
CONTACTBOX_API_KEY=sk-your-contactbox-key-here
GEMINI_API_KEY=AIza-your-gemini-key-here

# Optional
# CONTACTBOX_ENDPOINT=https://api.contactboxtools.me/v1/chat/completions
# GOOGLE_TTS_API_KEY=AIza-your-tts-key-here
# OCTAGON_ALLOW_CRITICAL_TOOLS=false   # keep false: blocks execute_js_mutation-class tools even after approval
# OCTAGON_PRODUCTION=true              # forces real login sessions (disables local-dev bypass)
